# Final sandbox image assembly. AGS builds the expensive inputs separately from
# the recipes in image/ and passes the resulting local image IDs here, so this
# recipe only copies finished artifacts and applies late configuration. It never
# installs packages or compiles tools.
ARG OS_IMAGE
ARG RUST_IMAGE
ARG PNPM_IMAGE
ARG GLIMPSE_IMAGE
FROM ${RUST_IMAGE} AS rust
FROM ${PNPM_IMAGE} AS pnpm
FROM ${GLIMPSE_IMAGE} AS glimpse
# AGS replaces the next line with one `FROM <image-id> AS vendor-N` per selected vendor tool.
# @ags-vendor-stages@

FROM ${OS_IMAGE}
USER root

COPY --from=rust /usr/local/rustup/ /usr/local/rustup/
COPY --from=rust /usr/local/cargo/ /usr/local/cargo/
COPY --from=pnpm /usr/local/lib/node_modules/pnpm/ /usr/local/lib/node_modules/pnpm/
RUN set -eu; \
    pnpm_bin="$(node -p "const pkg = require('/usr/local/lib/node_modules/pnpm/package.json'); typeof pkg.bin === 'string' ? pkg.bin : pkg.bin.pnpm")"; \
    test -n "$pnpm_bin"; \
    test -f "/usr/local/lib/node_modules/pnpm/$pnpm_bin"; \
    ln -s "../lib/node_modules/pnpm/$pnpm_bin" /usr/local/bin/pnpm; \
    test -L /usr/local/bin/pnpm; \
    /usr/local/bin/pnpm --version

# AGS replaces the next line with one COPY per selected vendor tool, so removed
# tools and renamed destinations never survive from an older image.
# @ags-vendor-copies@

# Glimpse sandbox shim: only the executable is copied from its artifact.
COPY --from=glimpse /out/glimpse-shim /opt/ags/glimpse-shim

# Configuration last: changing these files repeats only the steps below.
COPY uv.toml /etc/uv/uv.toml
COPY --chown=dev:dev tmux.conf /home/dev/.tmux.conf

USER dev
WORKDIR /workspace

ENV HOME=/home/dev
ENV PNPM_HOME=/usr/local/pnpm
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/home/dev/.cargo
ENV RUSTC_WRAPPER=/opt/ags/rustc-wrapper
ENV NPM_CONFIG_PREFIX=/home/dev/.npm-global
ENV PATH=/home/dev/.local/bin:/home/dev/.cargo/bin:/home/dev/go/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/pnpm:/usr/local/pnpm/bin:/home/dev/.npm-global/bin
