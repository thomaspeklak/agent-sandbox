#!/usr/bin/env python3
"""Inject validated 1Password Secure Note fields only into the final exec."""

import json
import os
import re
import sys

_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def fail(message):
    print(f"[ags] 1Password bootstrap failed: {message}", file=sys.stderr)
    raise SystemExit(1)


def field_name(item_number, field):
    label = field.get("label") if isinstance(field, dict) else None
    if isinstance(label, str) and label and "\0" not in label and "=" not in label:
        return f"field {label!r} in item {item_number}"
    return f"field in item {item_number}"


def read_document(fd, item_number):
    chunks = []
    try:
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
    except OSError:
        fail(f"could not read item {item_number}")
    finally:
        try:
            os.close(fd)
        except OSError:
            pass
    try:
        return json.loads(b"".join(chunks))
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail(f"invalid JSON in item {item_number}")


def load_environment(count):
    merged = {}
    for item_number, fd in enumerate(range(3, 3 + count), start=1):
        document = read_document(fd, item_number)
        if not isinstance(document, dict) or document.get("category") != "SECURE_NOTE":
            fail(f"item {item_number} is not a Secure Note")
        fields = document.get("fields")
        if not isinstance(fields, list):
            fail(f"item {item_number} has invalid fields")
        for field in fields:
            if not isinstance(field, dict):
                fail(field_name(item_number, field))
            # 1Password may include metadata-only fields. They intentionally
            # have no environment effect, even if their labels are malformed.
            if "value" not in field:
                continue
            description = field_name(item_number, field)
            label = field.get("label")
            if not isinstance(label, str) or not _NAME.fullmatch(label):
                fail(description)
            value = field["value"]
            if not isinstance(value, str) or "\0" in value:
                fail(description)
            merged[label] = value
    return merged


def main():
    if len(sys.argv) < 5 or sys.argv[1] != "--fd-count" or sys.argv[3] != "--":
        fail("invalid bootstrap invocation")
    try:
        count = int(sys.argv[2])
    except ValueError:
        fail("invalid descriptor count")
    if count < 1:
        fail("invalid descriptor count")
    command = sys.argv[4:]
    if not command:
        fail("missing final command")
    environment = os.environ.copy()
    environment.update(load_environment(count))
    try:
        os.execvpe(command[0], command, environment)
    except OSError:
        fail("could not start final command")


if __name__ == "__main__":
    main()
